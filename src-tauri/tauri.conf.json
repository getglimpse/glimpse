{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glimpse",
  "version": "../package.json",
  "identifier": "com.cromon.glimpse",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "glimpse",
        "width": 850,
        "height": 650,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://raw.githubusercontent.com https://github.com",
        "font-src": "'self' data:",
        "frame-src": "'self' asset: http://asset.localhost https: data:",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 https://raw.githubusercontent.com https://github.com",
        "font-src": "'self' data:",
        "frame-src": "'self' asset: http://asset.localhost http://localhost:1420 https: data:",
        "img-src": "'self' asset: http://asset.localhost http://localhost:1420 https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["$RESOURCE/**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
